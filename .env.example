# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=            # 中转站填这里，如 https://api.b.ai/v1；官方留空
OPENAI_MODELS=              # 可选，逗号分隔覆盖模型列表，如 gpt-4o-mini,claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEFAULT_MODEL=gpt-4o-mini            # 或 deepseek-flash（DeepSeek V4.1 Flash）
EMBEDDING_PROVIDER=local             # local（fastembed，免 key）| openai（需 embedding 接口）
EMBEDDING_MODEL=text-embedding-3-small

# Slack MCP（可选，留空则 notify 走本地 mock）
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=

# Email 通知（可选，配了就发邮件，可与 Slack 同时启用；Gmail 用「应用专用密码」）
SMTP_HOST=                   # 如 smtp.gmail.com
SMTP_PORT=587                # 587=STARTTLS，465=SSL
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                   # 留空用 SMTP_USER
NOTIFY_EMAIL_TO=             # 收件人，逗号分隔

# 安全
JWT_SECRET=change-me
REQUIRE_HUMAN_CONFIRM=false

# 基础设施（compose 内默认即可）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=copilot
MYSQL_READONLY_USER=readonly
MYSQL_READONLY_PASSWORD=readonly
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
